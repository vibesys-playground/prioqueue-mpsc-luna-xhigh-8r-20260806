  struct MpscLane {
      slots: Box<[MpscSlot]>,
      next_slot: AtomicUsize,
  }
  
  impl MpscLane {
      fn new(slot_count: usize) -> Result<Self, u32> {
          let mut slots = Vec::new();
          slots
              .try_reserve_exact(slot_count)
              .map_err(|_| STATUS_INTERNAL_ERROR)?;
          for _ in 0..slot_count {
              slots.push(MpscSlot::new());
          }
          Ok(Self {
              slots: slots.into_boxed_slice(),
              next_slot: AtomicUsize::new(0),
          })
      }
  
      fn claim_empty_slot(&self) -> Option<(usize, &MpscSlot)> {
          let slot_count = self.slots.len();
          let start = self.next_slot.load(AtomicOrdering::Relaxed) % slot_count;
          for offset in 0..slot_count {
              let index = (start + offset) % slot_count;
              let slot = &self.slots[index];
              if slot
                  .state
                  .compare_exchange(
                      SLOT_EMPTY,
                      SLOT_RESERVED,
                      AtomicOrdering::AcqRel,
                      AtomicOrdering::Acquire,
                  )
                  .is_ok()
              {
                  self.next_slot
                      .store((index + 1) % slot_count, AtomicOrdering::Relaxed);
                  return Some((index, slot));
              }
          }
          None
      }
  }
  
  struct MpscState {
      capacity: usize,
      max_value_size: usize,
      // `free_count` is only a fast full hint. Token state remains authoritative
      // while a producer or the consumer is between its two atomic updates.
