  		switch resp.status {
  		case statusValue:
  			value := resp.value
  			return queueOutput{DequeueVal: &value}, nil
  		case statusEmpty:
  			return queueOutput{DequeueNone: true}, nil
  		default:
  			return queueOutput{}, fmt.Errorf("dequeue returned invalid protocol status %d", resp.status)
