          return STATUS_INVALID;
      }
      let producer = match queue.producer(producer_id) {
          Ok(producer) => producer,
          Err(status) => return status,
      };
  
      unsafe { producer_out.write(Box::into_raw(Box::new(producer))) };
      STATUS_OK
  }
  
