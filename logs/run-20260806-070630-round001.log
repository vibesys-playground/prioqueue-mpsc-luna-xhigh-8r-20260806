  		switch resp.status {
  		case statusEnqueued:
  			value = true
  		case statusFull:
  			value = false
  		default:
  			return queueOutput{}, fmt.Errorf("enqueue returned invalid protocol status %d", resp.status)
  		}
  		return queueOutput{EnqueueOK: &value}, nil
