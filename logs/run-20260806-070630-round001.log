  	if value == "all" {
  		return []scenario{scenarioSPSC, scenarioMPSC, scenarioSPMC, scenarioMPMC}, nil
  	}
  	selected, err := parseScenario(value)
  	if err != nil {
  		return nil, err
  	}
  	return []scenario{selected}, nil
  }
  
