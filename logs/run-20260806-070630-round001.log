  #[no_mangle]
  pub unsafe extern "C" fn vspq_queue_create(
      capacity: u64,
      max_value_size: u64,
      producer_count: u32,
      consumer_count: u32,
      queue_out: *mut *mut Queue,
  ) -> u32 {
      if queue_out.is_null() {
          return STATUS_INVALID;
      }
      let queue = match Queue::new(capacity, max_value_size, producer_count, consumer_count) {
          Ok(queue) => queue,
          Err(status) => return status,
      };
  
      unsafe { queue_out.write(Box::into_raw(Box::new(queue))) };
      STATUS_OK
  }
  
  #[no_mangle]
  pub unsafe extern "C" fn vspq_queue_destroy(queue: *mut Queue) {
      if !queue.is_null() {
          drop(unsafe { Box::from_raw(queue) });
      }
  }
  
