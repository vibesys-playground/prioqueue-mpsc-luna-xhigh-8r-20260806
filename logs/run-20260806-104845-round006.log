                      || sequence == tail
                      || sequence.wrapping_add(1) == tail
                  {
                      pending = Some(pending.map_or(sequence, |old| old.min(sequence)));
                  }
              }
          }
          consumer.publication_reads[lane_index] = pending.unwrap_or(tail);
          consumer.repair_rechecks[lane_index] = true;
      }
  
