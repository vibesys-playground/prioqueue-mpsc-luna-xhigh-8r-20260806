  Optimize a multi-producer, single-consumer bounded priority queue.
  
  Headline metric: `total_ops_per_sec` (maximize).
  
  Preserve the required interface:
  - Provide a native shared library named `./priority-queue-candidate.so`.
  - Export the copying C ABI documented in
    `_evaluator/priority-queue/CANDIDATE_CONTRACT.md`.
  - Implement prioritized enqueue and dequeue for copied byte values using the
    capacity and value size supplied by the trusted runner.
  
  The candidate may use any language or combination of languages. The queue must
  remain linearizable, return lower numeric priorities first, never fabricate or
  duplicate items, and respect capacity. Items with equal priority may be returned
  in any order. Maximize trusted end-to-end operation throughput for the MPSC
  workload.
  
  Start from the editable Rust implementation in `src/lib.rs`. It is an
  intentionally naive correctness baseline, not part of the trusted evaluator.
  
  --- Makefile ---
  .PHONY: all clean priority-queue-candidate.so
  
  all: priority-queue-candidate.so
  
  priority-queue-candidate.so: Cargo.toml Cargo.lock src/lib.rs src/ffi.rs
  	cargo build --release --locked
  	cp "target/release/libpriority_queue_candidate.$$(test "$$(uname -s)" = Darwin && printf dylib || printf so)" "$@"
  
  clean:
  	cargo clean
  	rm -f priority-queue-candidate.so
  
  --- vibesys.input.toml ---
  version = 1
  
  [agent]
  domain = "generic"
  
  [workspace]
  seed = "../../starters/priority-queue-rs"
  
  [evaluator]
  source = "../../evaluators/priority-queue"
  
  [accuracy]
  command = [
    "go", "-C", "_evaluator/priority-queue",
    "run", ".", "check", "--workspace", "../..",
    "--scenario", "mpsc", "--operations", "24", "--trials", "50",
  ]
  timeout_seconds = 120
  
  [benchmark]
  command = [
    "go", "-C", "_evaluator/priority-queue",
    "run", ".", "benchmark", "--workspace", "../..",
    "--scenario", "mpsc", "--repetitions", "3",
  ]
  timeout_seconds = 300
  
  [benchmark.result]
  json_argument = "--output-json"
  metric = "total_ops_per_sec"
  

